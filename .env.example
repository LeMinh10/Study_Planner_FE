# Use the backend API by default. Set true only to preview local sample data.
VITE_USE_MOCK_API=false

# When mock API is disabled, Vite forwards /api requests to the backend below.
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://localhost:5059

# Legacy demo login bypasses the backend. Keep false when using real accounts.
VITE_ENABLE_DEMO_AUTH=false

# For a separate production API, set VITE_API_BASE_URL to its full API root.
# Example: VITE_API_BASE_URL=https://your-api.example.com/api/v1

# Endpoint paths are relative to VITE_API_BASE_URL. Match these to the deployed BE.
VITE_AUTH_REGISTER_PATH=/auth/register
VITE_AUTH_LOGIN_PATH=/auth/login
VITE_AUTH_PROFILE_PATH=/users/me
VITE_AUTH_CHANGE_PASSWORD_PATH=/users/me/change-password
